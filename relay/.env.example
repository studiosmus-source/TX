# Create TWO DISTINCT cryptographically random keys, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TX_TOKEN=replace-with-64-hex-characters
RX_TOKEN=replace-with-another-64-hex-characters
PORT=8080
# LOCAL_TEST_ONLY=true is for 127.0.0.1 tests ONLY; never use on public servers.
